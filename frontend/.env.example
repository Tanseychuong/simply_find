# Where the Django API lives.
# Development: leave VITE_API_URL empty; Vite proxies /api to BACKEND_URL.
BACKEND_URL=http://127.0.0.1:8000
# Production: the API's origin if it is not served from the same domain,
# e.g. https://api.simplyfind.example (no trailing slash).
VITE_API_URL=
# "Sign in with Google" client ID (same as the backend's GOOGLE_CLIENT_ID). Empty = hidden.
VITE_GOOGLE_CLIENT_ID=

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://user:password@localhost:5432/simplyfind
DB_CONN_MAX_AGE=300

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Premium — hours free users wait after approval
EARLY_ACCESS_HOURS=48

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Automatic ingestion (docs/ingestion.md)
# Dev: runserver starts the worker itself when this is True (default = DEBUG).
# Prod: set False and run `python manage.py run_ingestion_worker` as a worker process.
INGESTION_AUTOSTART=True
INGESTION_WORKER_INTERVAL_SECONDS=60
INGESTION_SOURCE_BATCH=10
INGESTION_ENRICH_BATCH=25
INGESTION_USER_AGENT=SimplyFindBot/1.0

# Landing page stats cache (seconds)
LANDING_STATS_CACHE_SECONDS=120
APP_LOG_LEVEL=INFO

# Login/register/password-reset rate limit per client IP
AUTH_THROTTLE_RATE=10/min
# Company accounts and in-app applications
# COMPANY_SIGNUP_THROTTLE_RATE=5/hour
# COMPANY_JOBS_THROTTLE_RATE=30/hour
# APPLICATIONS_THROTTLE_RATE=20/hour
# UPLOADS_THROTTLE_RATE=20/hour

# Password reset email. Blank BREVO_API_KEY = emails print to the console.
# Prod: Brevo (free) -> SMTP & API -> API keys; verify the sender address in Brevo.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=SimplyFind <no-reply@your-domain>
PASSWORD_RESET_TIMEOUT=3600
# Frontend base URL used in reset links (defaults to the first CORS origin)
# FRONTEND_URL=http://localhost:5173

# Production only (applied when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=0           # raise to 31536000 once HTTPS is confirmed working
# CSRF_TRUSTED_ORIGINS=https://api.example.com   # if admin login reports a CSRF origin error

# Media storage — Supabase Storage via its S3-compatible API (required when DEBUG=False).
# Create a PUBLIC bucket, then Project Settings → Storage → S3 Connection for the keys/region.
# Leave blank in dev to store uploads under backend/media/.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
# Private bucket for job-application files (CVs). Never public. Blank = they
# share the public bucket (unguessable names) and check --deploy warns.
SUPABASE_PRIVATE_BUCKET=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=5

# Render deploy hook for the static site: takedowns rebuild it at once (optional)
# FRONTEND_DEPLOY_HOOK=

# "Sign in with Google": OAuth client ID (Google Cloud Console -> Credentials).
# Same value as VITE_GOOGLE_CLIENT_ID in the frontend. Blank = off.
# GOOGLE_CLIENT_ID=

# Canonical public site (sitemap.xml, email links)
# SITE_URL=https://your-domain   (required when DEBUG=False)
# Days to keep applications after their job closes. Blank = keep until the
# applicant withdraws or deletes their account. A policy decision: keep the
# Privacy notice in sync. Enforced by `manage.py prune_applications`.
# APPLICATION_RETENTION_DAYS=

# --- Virus scanning (ClamAV clamd) -------------------------------------------
# Every upload is scanned. With DEBUG=False an unreachable scanner refuses
# uploads; set VIRUS_SCAN_REQUIRED=False only knowingly (a demo without ClamAV).
# Local: docker run -p 3310:3310 clamav/clamav:1.4
CLAMAV_HOST=
CLAMAV_PORT=3310
# VIRUS_SCAN_REQUIRED=False

# --- Sign-in cookies ------------------------------------------------------------
# Lax works when the API and website share a site (api.example + example).
# Different sites (e.g. two *.onrender.com hosts): AUTH_COOKIE_SAMESITE=None.
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=.your-domain
